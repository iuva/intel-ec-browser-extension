{
  "name": "cpu-test-browser-extension",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "scripts": {
    "dev:chrome": "vite --mode chrome",
    "dev:firefox": "vite --mode firefox",
    "dev:edge": "vite --mode edge",
    "build:chrome": "node scripts/build-with-python.cjs chrome",
    "build:firefox": "node scripts/build-with-python.cjs firefox", 
    "build:edge": "node scripts/build-with-python.cjs edge",
    "build:dist:chrome": "cross-env vite build --mode chrome",
    "build:dist:firefox": "cross-env vite build --mode firefox",
    "build:dist:edge": "cross-env vite build --mode edge",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.3"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "^0.10.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/test-utils": "^2.5.0",
    "cross-env": "^10.0.0",
    "jsdom": "^24.1.3",
    "less": "^4.4.1",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.6.3",
    "vite": "^5.0.0",
    "vite-plugin-web-extension": "^4.0.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.12",
    "webextension-polyfill": "^0.10.0"
  }
}
